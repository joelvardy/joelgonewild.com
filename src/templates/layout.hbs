<!doctype html>
<html lang="en-GB">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{title}} | Joel Vardy</title>
        <meta name="description" content="{{description}}">
        <meta name="theme-color" content="#0077ff">
        <meta name="msapplication-navbutton-color" content="#0077ff">
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
        <meta property="og:url" content="https://www.joelgonewild.com{{path}}">
        <meta property="og:title" content="Travelling with Joel - {{title}}">
        <meta property="og:description" content="{{description}}">
        <meta property="og:type" content="{{ogType}}">
        <meta property="og:image" content="{{image}}">
        <meta name="twitter:card" content="{{twitterCard}}">
        <meta name="twitter:title" content="Travelling with Joel - {{title}}">
        <meta name="twitter:description" content="{{description}}">
        <meta name="twitter:creator" content="@joelvardy">
        <meta name="twitter:image" content="{{image}}">
        <link rel="icon" type="image/svg+xml" href="/assets/logo.svg">
        <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">
        <link rel="canonical" href="https://www.joelgonewild.com{{path}}">
        <link rel="alternate" type="application/rss+xml" title="Joel Gone Wild" href="/feed.xml">
        <style>{{{css}}}</style>
    </head>
    <body>
        <div id="app">

            <header>
                <a href="/" title="List of posts">
                    <img src="/assets/logo.svg" alt="Joel Gone Wild" width="417" height="362">
                </a>
            </header>

            <main>
                {{#block "content"}}{{/block}}
            </main>

        </div>
    </body>
</html>
