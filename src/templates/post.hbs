{{#extend "layout"}}
{{#content "content"}}
<div class="container">

    <div class="post">

        <picture>
            <source type="image/avif" srcset="{{srcset post.slug post.hero "avif"}}" sizes="(max-width: 600px) 95vw, (max-width: 800px) 80vw, 70vw">
            <img class="hero-photo" alt="{{post.heroAlt}}" src="/{{post.slug}}/{{post.hero}}-1600.jpg" srcset="{{srcset post.slug post.hero "jpg"}}" sizes="(max-width: 600px) 95vw, (max-width: 800px) 80vw, 70vw" fetchpriority="high">
        </picture>

        <h2>{{post.title}}</h2>
        <p><strong>{{date post.date}}</strong></p>

        {{{post.html}}}

    </div>

</div>
{{/content}}
{{/extend}}
