{
  "name": "joelgonewild.com",
  "private": true,
  "version": "1.0.0",
  "description": "Categorised blog posts from my trips.",
  "author": "Joel Vardy",
  "scripts": {
    "build": "tsx process.ts",
    "dev": "tsx watch --include 'src/**' --include 'posts/**' process.ts & serve public",
    "typecheck": "tsc --noEmit",
    "deploy": "./node_modules/serverless/bin/serverless.js deploy --verbose"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "handlebars": "^4.7.10",
    "handlebars-layouts": "^3.1.4",
    "markdown-it": "^14.3.3",
    "sass": "^1.105.2",
    "serve": "^14.2.6",
    "serverless": "^2.51.2",
    "sharp": "^0.34.5",
    "slugify": "^1.6.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
